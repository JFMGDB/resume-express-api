# URL de conexão completa do PostgreSQL (ex: Vercel Postgres ou Neon)
DATABASE_URL="postgresql://user:password@host:port/database"

# (Opcional) URL para o banco de dados de teste de integração (não vai para o Vercel)
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/curriculo_express_test"

# Chave secreta para autenticação da API (Bearer Token)
API_SECRET_KEY="uma_chave_muito_segura_aqui_gerada_com_openssl"
